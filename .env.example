DATABASE_URL=postgresql://localhost/equalfi_agent
# API and worker share this encryption key; supply 32 random bytes as base64.
TRANSACTION_ENCRYPTION_KEY=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# The authorization private key exists ONLY in the execution worker environment.
PRIVY_AUTHORIZATION_KEY=
# App name -> secret. Browser never receives these secrets.
APP_CONNECTIONS_JSON={"statics":"replace-with-32-or-more-random-characters"}
PORT=4310
HOST=127.0.0.1
# Start disabled. Reviewed configuration is required to enable signing.
EXECUTION_ENABLED=false
PRIVY_SIGNING_REHEARSED=false
DEPLOYMENTS_FILE=
PILOT_USERS_JSON=[]
AGENT_MODEL=
MODEL_DAILY_USER_USD=
MODEL_DAILY_GLOBAL_USD=
MODEL_MAX_REQUEST_USD=
EXA_API_KEY=
